            <pper:dateOfMarriage rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1973-07-04</pper:dateOfMarriage>
            <!-- dátum sobáša slovom -->
            <rfo:dateOfMarriageText xml:lang="sk">Štvrtého júla tisícdeväťstosedemdesiattri</rfo:dateOfMarriageText>
