        <!-- Poznámky -->
        <skos:note>Voľnotextové poznámky, môže sa vyskytovať násobne..</skos:note>

        <!-- registratúra -->
        <reg:registryEntry>
          <reg:RegistryEntry>
            <!-- meno a priezvisko matrikára -->
