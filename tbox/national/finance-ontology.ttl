fin:supplier a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "dodávateľ"@sk, "supplier"@en .

fin:valueWithVAT a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "cena s dph"@sk, "price including VAT"@en;
  rdfs:domain fin:Price;
  rdfs:range xsd:decimal .

fin:FundingScheme a owl:Class;
  rdfs:label "Schéma financovania"@sk, "Funding scheme"@en;
  rdfs:isDefinedBy fin:2025c .

fin:CallForFunding a owl:Class;
