  rdfs:range xsd:date .

fin:wasApproved a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "stav vyhodnotenia žiadosti"@sk, "was approved"@en;
  rdfs:domain fin:FundingRequest;
  rdfs:range xsd:boolean .

fin:FundedProject a owl:Class;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "Financovaný projekt"@sk, "Funded project"@en .

fin:fundedProject a owl:ObjectProperty, rdf:Property;
