fin:FundingSourceType a owl:Class;
  rdfs:subClassOf skos:Concept;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "Typ zdroja financovania"@sk, "Funding source type"@en .

fin:legalFormRestriction a owl:ObjectProperty, rdf:Property;
