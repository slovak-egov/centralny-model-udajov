fin:bankName a rdf:Property, owl:DatatypeProperty;
  rdfs:domain fin:BankCode;
  rdfs:label "bank name"@en, "názov banky"@sk;
  skos:note "[Formát reprezentácie: Textový reťazec.]"@sk, "[Povinne spracovateľná veľkosť dátového poľa: Najmenej 1023 znakov.]"@sk,
    "[Hodnoty: Pre tuzemské banky sa vypĺňa v súlade s aktuálnym Prevodníkom identifikačných kódov pre tuzemský platobný styk, ktorý zverejňuje Národná banka Slovenska, stĺpec Názov.]"@sk,
    "[Pravidlá použitia: Obsahuje celé meno v jednom reťazci, so všetkými časťami v správnom poradí, čo znamená na správnom mieste.]"@sk;
  rdfs:range xsd:string;
  rdfs:isDefinedBy fin:2025c;
  skos:example "Prvá vymyslená banka, a.s."@sk;
  rdfs:description "Obsahuje celé meno banky."@sk .

fin:bankCode a owl:ObjectProperty, rdf:Property;
