  rdfs:isDefinedBy fin:2025c;
  rdfs:label "zálohová faktúra"@sk, "advance invoice"@en;
  rdfs:domain fin:Invoice;
  rdfs:range xsd:boolean .

fin:isCanceled a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "zrušené"@sk, "canceled"@en;
