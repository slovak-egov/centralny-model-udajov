fin:order a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "objednávka"@sk, "order"@en;
  rdfs:range fin:Order .

fin:orderer a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "objednávateľ"@sk, "orderer"@en .

fin:payed a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:domain fin:Price;
  rdfs:range xsd:date;
  rdfs:label "dátum úhrady"@sk, "payment date"@en .

fin:price a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "cena"@sk, "price"@en;
  rdfs:range fin:Price .

fin:recordCreated a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "dátum vytvorenia dokladu"@sk, "record creation date"@en;
