fin:allocation a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "alokovaná suma"@sk, "allocated amount"@en;
  rdfs:range xsd:decimal .

fin:maximalFunding a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:domain fin:CallForFunding;
  rdfs:range xsd:decimal;
  rdfs:label "maximálna výška dotácie"@sk, "maximum funding amount"@en .

