fin:2025c a owl:Ontology;
  dct:title "Ontológia finančných entít";
  dct:creator <http://www.linkedin.com/in/emillazenga>;
  dct:contributor <http://www.linkedin.com/in/miroslavliska>, <http://www.linkedin.com/in/mareksurek>;
  owl:versionInfo "2025c";
  dct:publisher <https://data.gov.sk/id/legal-subject/50349287> .

fin:Invoice a owl:Class;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "Faktúra"@sk, "Invoice"@en .

fin:invoices a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:range egov:DocumentCollection;
  rdfs:label "invoices"@en, "faktúry"@sk .

fin:Order a owl:Class;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "Objednávka"@sk, "Order"@en .

fin:Contract a owl:Class;
  rdfs:label "Zmluva"@sk, "Contract"@en;
  rdfs:isDefinedBy fin:2025c .

fin:Price a owl:Class;
  rdfs:isDefinedBy fin:2025c;
  rdfs:subClassOf egov:Amount;
  rdfs:label "Cena"@sk, "Price"@en .

fin:accounted a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "dátum zaúčtovania"@sk, "posting date"@en;
  rdfs:domain fin:Price;
  rdfs:range xsd:date .

fin:currency a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "mena"@sk, "currency"@en, "Währung"@de;
  rdfs:range fin:Currency;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.2.9.1>;
  rdfs:description "Relácia na použitú menu definovanú hodnotami číselníka CL010138 Jednotka meny."@sk .

fin:receivedPayment a rdf:Property, owl:ObjectProperty;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "prijatá finančná dávka"@sk, "received payment"@en .

fin:contracts a rdf:Property, owl:ObjectProperty;
  rdfs:label "zmluvy"@sk, "contracts"@en;
  rdfs:isDefinedBy fin:2025c;
  rdfs:range egov:DocumentCollection .

fin:delivered a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:label "dátum doručenia"@sk, "date of receipt"@en .

fin:invoice a owl:ObjectProperty, rdf:Property;
  rdfs:isDefinedBy fin:2025c;
  rdfs:range fin:Invoice;
  rdfs:label "faktúra"@sk, "invoice"@en .

