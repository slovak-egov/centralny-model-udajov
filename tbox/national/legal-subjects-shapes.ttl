    sh:path lsub:legalForm ;
    sh:class lsub:LegalForm ;
    sh:nodeKind sh:IRI .	
	
sha-rpo:LegalFormShape
    a sh:NodeShape ;
    sh:targetClass lsub:LegalForm ;
	dct:subject <https://data.gov.sk/id/egov/isvs/420> ;
