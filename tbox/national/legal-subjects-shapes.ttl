    sh:property sha-rpo:LegalFormShape-type ,
        sha-egov:ThingWithValidity-timeValidity .

sha-rpo:LegalFormShape-type
    a sh:PropertyShape ;
    sh:order 8 ;
	dct:subject <https://data.gov.sk/id/egov/isvs/420> ;
	rdfs:isDefinedBy sha-rpo:2025b ;
    sh:path dct:type ;
    sh:class lsub:LegalFormType ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

sha-rpo:LegalFormTypeShape
    a sh:NodeShape ;
    sh:targetClass lsub:LegalFormType ;
