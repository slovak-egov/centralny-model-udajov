egov:formattedNumber a owl:DatatypeProperty, rdf:Property;
  rdfs:label "formátované číslo"@sk, "formatierte Nummer"@de, "formatted number"@en;
  rdfs:range xsd:string;
  skos:note "Ak je použité formátované číslo, nepoužíva sa neformátovaná podoba."@sk;
  kdp:xmlElementName "FormattedNumber";
  rdfs:isDefinedBy egov:2025c;
  rdfs:domain egov:TelephoneNumber;
  skos:example "+421 48 4324134"@sk;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.1>;
  rdfs:description "Obsahuje reprezentáciu telekomunikačného číselného reťazca. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb."@sk .

egov:internationalAreaCode a owl:DatatypeProperty, rdf:Property;
  rdfs:label "medzinárodné smerové číslo"@sk, "internationale Vorwahlr"@de, "international area code"@en;
  rdfs:range xsd:string;
  kdp:xmlElementName "InternationalCountryCode";
  rdfs:isDefinedBy egov:2025c;
  rdfs:domain egov:TelephoneNumber;
  skos:example "+421, 00421"@sk;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.2>;
  rdfs:description "Kód krajiny podľa ITU, ktorý identifikuje špecifickú krajinu, krajiny v integrovanom číselnom pláne alebo špecifickú geografickú oblasť. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb."@sk .

egov:nationalNumber a owl:DatatypeProperty, rdf:Property;
  rdfs:label "národné číslo"@sk, "nationale Nummer"@de, "national number"@en;
  rdfs:range xsd:string;
  skos:note "V Slovenskej republike sa nepoužíva."@sk;
  kdp:xmlElementName "NationalNumber";
  rdfs:isDefinedBy egov:2025c;
  rdfs:domain egov:TelephoneNumber;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.3>;
  rdfs:description "Obsahuje národné číslo. Niektoré oblasti majú dve predvoľby – vnútroštátne a zahraničné medzimestské predvoľby, tento prvok obsahuje vnútroštátnu predvoľbu."@sk .

egov:areaCityCode a owl:DatatypeProperty, rdf:Property;
  rdfs:label "smerové číslo"@sk, "routing Nummer"@de, "area city code"@en;
  rdfs:range xsd:string;
  skos:note "V Slovenskej republike je to ekvivalent národného cieľového kódu."@sk;
  kdp:xmlElementName "AreaCityCode";
  rdfs:isDefinedBy egov:2025c;
  rdfs:domain egov:TelephoneNumber;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.4.2.4>;
  rdfs:description "Definuje buď číslovanie v rámci jednej krajiny (alebo skupiny krajín či geografickej oblasti) alebo sieť – službu. Relácia na reprezentáciu telekomunikačného číselného reťazca. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb."@sk .

egov:internetAddress a owl:DatatypeProperty, rdf:Property;
  rdfs:label "internetová adresa"@sk, "Internetadresse"@de, "internet address"@en;
  rdfs:range xsd:string;
  kdp:xmlElementName "InternetAddress";
  rdfs:isDefinedBy egov:2025c;
  rdfs:domain egov:ElectronicAddress;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.5.1>;
  rdfs:description "Uvádza sa kontakt pre rôzne typy elektronických adries v prostredí internetu. Rozoznávajú sa typy ako mailto (mailová adresa), http (webová adresa), ftp, ldap a podobne. Časť adresy vo väčšine prípadov dodržiava radenie textových reťazcov podľa podradenia doménových mien."@sk .

egov:subscriberNumber a owl:DatatypeProperty, rdf:Property;
  rdfs:description "Číslo, ktoré identifikuje užívateľa siete alebo číslovacej oblasti. Vypĺňa sa v súlade s aktuálnym číslovacím plánom, ktorý svojim opatrením vydáva Úrad pre reguláciu elektronických komunikácií a poštových služieb."@sk;
