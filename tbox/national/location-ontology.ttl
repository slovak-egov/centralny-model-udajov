loca:BuildingPart a owl:Class;
  rdfs:label "Teil des Gebäudes"@de, "Building Part"@en, "Časť budovy"@sk;
  rdfs:subClassOf egov:ThingWithValidity, loca:ThingWithPhysicalAddress;
  rdfs:isDefinedBy loca:2025b .

loca:streetName a owl:DatatypeProperty, rdf:Property;
  rdfs:domain loca:Street;
  rdfs:isDefinedBy loca:2025b;
  rdfs:label "názov ulice"@sk, "street Name"@en, "Straßenname"@de;
  rdfs:range xsd:string;
  skos:example "5223 W High Road"@en, "Lachova, Námestie P. O. Hviezdoslava, Nad humnom"@sk;
  rdfs:description "Obsahuje názov ulice. Ak obec nemá názov ulice, udáva sa tu názov obce. Ak má obec definovaný vlastný register, zoznam alebo základný číselník ulíc, vypĺňa sa v súlade s ním, ak nemá, štruktúra zápisu ulice sa nepredpisuje. Ak obec nemá ulice, nevypĺňa sa."@sk;
  kdp:xmlElementName "StreetName";
  skos:note "Údaje sa zadávajú z dôvodu porovnateľnosti v neskrátenej podobe. Mnohé ulice sú v zahraničí označované číselne – toto sa nepovažuje za číselný údaj za ulicou tak ako sa udáva v Slovenskej republike. Tento prvok nie je zložený dátový prvok pre základný číselník."@sk;
  adms:identifier <https://data.gov.sk/id/identifier/kdp-id/D.1.3.7> .

