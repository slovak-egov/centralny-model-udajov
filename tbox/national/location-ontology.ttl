geo:wktLiteral a rdfs:Datatype .

geo:hasGeometry a owl:ObjectProperty;
  rdfs:range geo:Geometry .

geo:asWKT a owl:DatatypeProperty;
  rdfs:domain geo:Geometry;
  rdfs:range geo:wktLiteral .

loca:floorNumber a owl:DatatypeProperty, rdf:Property;
  rdfs:isDefinedBy loca:2025b;
  rdfs:label "číslo podlažia"@sk, "floor number"@en, "Stockwerknummer"@de;
  rdfs:range xsd:int;
  rdfs:description "Obsahuje informáciu o umiestnení časti budovy na príslušnom podlaží budovy. Podlažie sa označuje od prvého nadzemného podlažia (prízemia) číselným radom od čísla 1 a od prvého podzemného podlažia s číselným radom od čísla -1. Číslo 0 sa nepoužíva."@sk;
  rdfs:domain loca:PhysicalAddress .
